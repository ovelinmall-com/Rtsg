<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:name=".OvelinApplication"
        android:allowBackup="false"
        android:largeHeap="true"
        android:label="OVELIN SPACE"
        android:supportsRtl="true"
        android:theme="@style/Theme.OvelinSpace">
        <!-- Some OEM ROMs (seen here on a Transsion/itel build) read application metaData
             unconditionally when binding a secondary process, instead of null-checking it the
             way AOSP does. Without at least one meta-data entry that Bundle is null, which
             crashes com.ovelin.space:p0 on every launch of a cloned app's process. -->
        <meta-data android:name="com.ovelin.space.ENGINE" android:value="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
